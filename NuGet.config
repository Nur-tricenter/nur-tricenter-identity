<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    NuGet feeds for building this service.

    The organization feed is where the Nur.Tricenter.* platform kernels are
    published. This service consumes Nur.Tricenter.Security from it (the JWT
    bearer validator + per-permission authorization policies), so the
    checkout builds on its own: no sibling repository is needed on disk,
    and the Docker image builds from this folder as the context.

    AUTHENTICATION

    GitHub Packages expects a classic personal access token. It needs the
    read:packages scope to restore and write:packages to push. Never put
    the token in this file.

    Register the feed once, from a shell, replacing the two placeholders:

      dotnet nuget add source https://nuget.pkg.github.com/Nur-tricenter/index.json
        [name] Nur-tricenter
        [username] YOUR_GITHUB_USER
        [password] YOUR_TOKEN

    Or set the two environment variables below on the machine, and the
    credentials block at the bottom of this file picks them up
    automatically:

      setx NUGET_USERNAME YOUR_GITHUB_USER
      setx NUGET_TOKEN YOUR_TOKEN
  -->

  <packageSources>
    <clear />

    <!-- Official feed: still needed for every third-party package. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!-- The organization: where Nur.Tricenter.* is published. -->
    <add key="Nur-tricenter" value="https://nuget.pkg.github.com/Nur-tricenter/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Source mapping: each package family is bound to a specific feed so that
    Central Package Management knows where to look for every PackageReference.
    Without this mapping, multi-feed setups raise NU1507 (Every PackageReference
    exists in every feed) and NuGet either hits the wrong feed or warns.
    With it, NU1507 is silent and the build is deterministic.

    The mapping must be kept in sync with the Directory.Packages.props
    PackageVersion entries. A reference that is not mapped is restored from
    every feed in turn.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Nur-tricenter">
      <!--
        ONLY the platform kernels live here. They are published to GitHub Packages by the
        shared-kernels repository.

        The Joseco.* libraries are deliberately NOT mapped here: they are public packages on
        nuget.org. Mapping them to this feed makes restore fail with NU1101 "No packages exist
        with this id in source(s): Nur-tricenter ... the following source(s) were not considered:
        nuget.org", because package source mapping is exclusive — mapping a pattern to a feed means
        NuGet will not look anywhere else for it. It only went unnoticed locally because the
        global packages cache already held them; a clean environment (a Docker build, a fresh CI
        agent, a new machine) hits it immediately.
      -->
      <package pattern="Nur.Tricenter.*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    Credentials for the private feed. Without this block NuGet cannot
    authenticate and every restore of a Nur.Tricenter.* package fails with
    401 while the token itself is perfectly valid; the request never
    carries one.

    The values are environment variables, never literals: a credential does
    not belong in version control. The Docker build supplies them as build
    secrets (see the Dockerfile); a local build reads them from the
    machine.
  -->
  <packageSourceCredentials>
    <Nur-tricenter>
      <add key="Username" value="%NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%NUGET_TOKEN%" />
      <add key="ValidAuthenticationTypes" value="basic" />
    </Nur-tricenter>
  </packageSourceCredentials>

</configuration>
